# Supabase — get from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used to build QR code verify URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InforU (InforUMobile) SMS — server-side only
INFORU_USERNAME=
INFORU_TOKEN=
# Sender name shown on recipients' phones — max 11 Latin characters
INFORU_SENDER=
# Set to true locally to skip real sending and use the dev preview page instead
SMS_MOCK=true

# Google OAuth (server-side only; consumed by Supabase Auth). Local dev reads
# these via supabase/config.toml. Production sets the Google provider in the
# Supabase dashboard instead. Authorized redirect URI in Google Cloud Console:
#   https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# IMPORTANT: In the Supabase dashboard (Authentication settings), automatic
# account linking must be enabled so a returning user's Google identity links
# to their existing invited account (same verified email) instead of creating a
# separate account. Without it, invited users' Google sign-in will fail.
